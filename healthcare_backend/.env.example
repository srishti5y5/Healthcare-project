# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/healthcare_db

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── ML ────────────────────────────────────────────────────────────────────────
MODEL_PATH=app/ml/model.joblib
TRAINING_DATA_PATH=data/india_healthcare_district_data.csv
